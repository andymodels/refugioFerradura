<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>br.com.refugio.semana</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/engine-runner/src/semana-rotina.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/engine-runner</string>
  <!-- Reposição diária (modelo do blog UM2TRÊS): produz no máximo 2 dias por execução
       (os que faltam nos próximos 8), cada um com revisor independente. Se o Mac estava dormindo,
       o launchd roda assim que ele acordar. Se a cota do Claude Code acabar, o script
       para na primeira falha e a próxima execução tenta de novo. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/refugio-semana.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/refugio-semana.err.log</string>
</dict>
</plist>
